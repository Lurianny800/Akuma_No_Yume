MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2129518618}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de77de9107ad01f40a6f7b550d61a7a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterImage: {fileID: 267991190}
  dialogueText: {fileID: 267991189}
  dialoguePanel: {fileID: 267991188}
  dialogue1:
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "Uf... Qu\xE9 hambre... \xBFCu\xE1nto tiempo he estado aqu\xED
      sentada?"
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "Parece que pap\xE1 tambi\xE9n llegar\xE1 tarde hoy\u2026"
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "A ver qu\xE9 puedo encontrar para comer..."
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "No tengo energ\xEDa para cocinar algo mejor ahora."
  dialogue2:
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "*yawn* Uff\u2026 Qu\xE9 sue\xF1o me entra siempre despu\xE9s de
      comer\u2026 Creo que me echar\xE9 una peque\xF1a siesta. Igual, ahora prefiero
      dormir que salir..."
  dialogue3:
  - characterSprite: {fileID: 21300000, guid: d6d536440f828774bb46fbe0ac69a048, type: 3}
    dialogueText: "Ay no, \xBFcu\xE1nto tiempo llevo dormida? Ir\xE9 a lavarme la
      cara. "
  typingSpeed: 0.05
  animationPanel: {fileID: 628916641}
  panelAnimator: {fileID: 628916645}
